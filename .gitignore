# machine-local runtime state (rebuildable by the daemon scanning transcripts)
.state/
# credentials and private local configuration never belong in a distributable clone
.env
.env.*
!.env.example
auth.json
# raw agent transcripts are immutable local evidence, not release artifacts
*.jsonl
*.jsonl.zst
# derived index (rebuildable from markdown)
.llmwiki/
__pycache__/
*.pyc
.DS_Store
.omc/
# per-repo team configs are user-local (the tracked configs/default.toml.example is the template)
configs/*.toml
# Node/Bun (TS rewrite)
node_modules/
*.tsbuildinfo
bun.lockb
docs/
reference/
